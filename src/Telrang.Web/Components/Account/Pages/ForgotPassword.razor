@page "/Account/ForgotPassword"

@using System.ComponentModel.DataAnnotations

@inject AccountService Accounts
@inject IdentityRedirectManager RedirectManager
@inject SettingsService Settings

<PageTitle>Forgot password</PageTitle>

<h1>Forgot password</h1>
@if (!Settings.Current.Mail.IsConfigured)
{
    <p>Password recovery is not available on this server.</p>
}
else
{
<div class="row">
    <div class="col-md-6 col-lg-4">
        <EditForm Model="Input" FormName="forgot-password" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <FormGuardFields />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.Email" id="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label for="Input.Email" class="form-label">Email</label>
                <ValidationMessage For="() => Input.Email" class="text-danger" />
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Send link</button>
        </EditForm>
     </div>
</div>
}

@code {
    private static readonly TimeSpan MinimumAnswerTime = TimeSpan.FromMilliseconds(300);

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override void OnInitialized()
    {
        Input ??= new();
    }

    private async Task OnValidSubmitAsync()
    {
        if (!Settings.Current.Mail.IsConfigured) return;
        // Same response for every address (DESIGN.md §14.6): the service decides whether a mail is
        // queued; this page never branches on it. The answer is padded to a fixed minimum, so a verified account's
        // extra database work (link and outbox rows) does not show in the response time (pentest AV-15e).
        var started = System.Diagnostics.Stopwatch.GetTimestamp();
        await Accounts.RequestPasswordResetAsync(Input.Email);
        var left = MinimumAnswerTime - System.Diagnostics.Stopwatch.GetElapsedTime(started);
        if (left > TimeSpan.Zero) await Task.Delay(left);
        RedirectManager.RedirectTo("Account/ForgotPasswordConfirmation");
    }

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = "";
    }
}
