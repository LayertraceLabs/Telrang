@* Honeypot + signed render time for publicly exposed forms (Security/FormGuard). The honeypot is
   moved off-screen by CSS (no style attribute: CSP), skipped by keyboard and hidden from screen readers. *@
@inject Telrang.Web.Security.FormGuard Guard
<div class="hp-field" aria-hidden="true">
    <label for="@id">Website</label>
    <input id="@id" name="@Telrang.Web.Security.FormGuard.HoneypotField" type="text" tabindex="-1" autocomplete="off" value="" />
</div>
<input type="hidden" name="@Telrang.Web.Security.FormGuard.StampField" value="@stamp" />

@code {
    private readonly string id = "hp-" + Guid.NewGuid().ToString("N")[..8];
    private string stamp = "";

    /// <summary>A stamp posted with an earlier page of the same form (a multi-page vote): rendered again while it is valid,
    /// so the fill time counts from the first page. Forged or expired: a new one.</summary>
    [Parameter] public string? Keep { get; set; }

    /// <summary>Oldest <see cref="Keep"/> stamp reused; null = <c>Abuse:FormMaxMinutes</c>.</summary>
    [Parameter] public TimeSpan? MaxAge { get; set; }

    protected override void OnParametersSet()
    {
        if (Keep is { Length: > 0 } kept && Guard.Check(null, kept, MaxAge) is Telrang.Web.Security.FormCheck.Ok or Telrang.Web.Security.FormCheck.TooFast)
            stamp = kept;
        else if (stamp.Length == 0)
            stamp = Guard.CreateStamp();
    }
}
