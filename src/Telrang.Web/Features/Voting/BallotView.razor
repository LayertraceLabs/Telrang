@* Read-only view of one of the visitor's own responses: the question's answer in a simple poll, every question's under
   its prompt (and page and group titles) otherwise. *@
@if (VoteLayout.IsSimple(Definition))
{
    var q = Definition.Questions[0];
    <AnswerView Question="q" Answer="AnswerOf(q)" />
}
else
{
    @foreach (var pg in VoteLayout.Pages(Definition))
    {
        @if (pg.Page is { Title.Length: > 0 } pp)
        {
            <h3 class="h6 text-secondary text-break mt-3" @key="pp.Key">@pp.Title</h3>
        }
        @foreach (var block in pg.Blocks)
        {
            @if (block.Group is { } g)
            {
                <p class="fw-semibold text-break mb-1" @key="g.Key">@g.Title</p>
            }
            @foreach (var q in block.Questions)
            {
                <div class="ballot-answer" @key="q.Key">
                    <p class="small fw-semibold text-break mb-1">@BallotService.QuestionLabel(Definition, q)</p>
                    <AnswerView Question="q" Answer="AnswerOf(q)" />
                </div>
            }
        }
    }
}

@code {
    [Parameter, EditorRequired] public PollDefinition Definition { get; set; } = default!;
    [Parameter, EditorRequired] public MyBallot Ballot { get; set; } = default!;

    private QuestionAnswer? AnswerOf(PollQuestion q) =>
        Ballot.Answers.TryGetValue(q.Key, out var a) ? a
        : q.Key == Definition.Questions[0].Key ? new QuestionAnswer { Ranked = Ballot.Ranked, Points = Ballot.Points, Dates = Ballot.Dates }
        : null;
}
