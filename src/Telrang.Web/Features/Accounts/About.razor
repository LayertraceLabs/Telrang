@page "/about"
@layout PublicLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = AppPolicies.NotGated)]
@inject SettingsService Settings
@inject NavigationManager Nav

<PageTitle>About - @Settings.AppName</PageTitle>

@if (markdown is not null)
{
    <div class="legal-page">@MarkdownRenderer.Render(markdown, MarkdownRenderer.AdminMaxLength)</div>
}
@if (contact is not null)
{
    @* DESIGN.md §34.8: the admin's contact line for reports, plain text. *@
    <p class="legal-report-contact">Reports · <bdi>@contact</bdi></p>
}

@code {
    private string? markdown, contact;

    protected override void OnInitialized()
    {
        var s = Settings.Current;
        if (!s.HasLegalPage)
        {
            Nav.NotFound();
            return;
        }
        markdown = s.LegalPageMarkdown;
        contact = s.ReportsContact;
    }
}
