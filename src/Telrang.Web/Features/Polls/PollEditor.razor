@using Telrang.Web.Features.Accounts
@using Telrang.Web.Features.Voting
@* The poll form (DESIGN.md §20.2, §34.5). Code: PollEditor.razor.cs. A simple poll (one question, no pages or groups) gets
   the simple editor: the poll's fields, the one QuestionEditor and the add bar beside the preview. Anything more gets the
   structured editor: tabs, the outline beside the selected item, and the same QuestionEditor. Field ids come from DraftError
   paths (EditorContext.Id), each error sits under its control and is referenced by aria-describedby. *@
@{ claimed.Clear(); var simple = DraftOutline.IsSimple(draft); EnsureSelection(); }

<div class="@(simple ? "row g-4" : "editor-structured") editor-layout" data-draft-key="@DraftKey">
    <div class="@(simple ? "col-lg-7" : "") editor-form">
        <CascadingValue Value="help">
        <div class="editor-help-row">
            @if (!simple)
            {
                <span class="small text-secondary me-auto editor-size">@SizeLine</span>
            }
            <HelpAllButton State="help" Changed="StateHasChanged" />
        </div>
        @if (restored)
        {
            <p class="small alert alert-info py-1 px-2 mb-3 draft-notice" role="status">
                Draft restored. <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick="DiscardDraftAsync">Discard</button>
            </p>
        }

        @Basics(simple)

        @if (simple)
        {
            <QuestionEditor @key="KeyOf(draft.Questions[0])" Editor="ctx" Question="draft.Questions[0]" Index="0" Simple="true" ShowText="simpleText" />
            @AddBar(null)
            @VotingAndResults()
        }
        else
        {
            <div class="editor-tabs" role="tablist" aria-label="Poll form">
                @Tab(EditorTab.Questions, "Questions")
                @Tab(EditorTab.Voting, "Voting and results")
                @Tab(EditorTab.Preview, "Preview")
            </div>
            <div class="editor-tab-panel" role="tabpanel" id="@uid-panel" aria-labelledby="@uid-tab-@tab">
                @switch (tab)
                {
                    case EditorTab.Questions:
                        <div class="row g-3">
                            <div class="col-md-4">
                                @Outline()
                            </div>
                            <div class="col-md-8 editor-item">
                                @SelectedItem()
                            </div>
                        </div>
                        break;
                    case EditorTab.Voting:
                        @VotingAndResults()
                        break;
                    case EditorTab.Preview:
                        <PollPreview Draft="draft" Definition="ctx.Result.Definition" DefaultTimeZone="@DefaultTimeZone" Limits="Limits" />
                        break;
                    default:
                        throw new InvalidOperationException();
                }
            </div>
        }

        @{ var unplaced = Unplaced(simple).ToList(); }
        @if (unplaced.Count > 0)
        {
            <div class="alert alert-danger mt-3 mb-0" role="alert">
                <ul class="mb-0 ps-3">
                    @foreach (var m in unplaced)
                    {
                        <li>@m</li>
                    }
                </ul>
            </div>
        }
        </CascadingValue>
        @ChildContent
    </div>

    @if (simple)
    {
        <div class="col-lg-5 editor-preview-col">
            <div class="editor-preview">
                <h2 class="h6 text-secondary text-uppercase editor-preview-title">Preview</h2>
                <PollPreview Draft="draft" Definition="ctx.Result.Definition" DefaultTimeZone="@DefaultTimeZone" Limits="Limits" />
            </div>
        </div>
    }
</div>

@code {
    private RenderFragment Basics(bool simple) => __builder =>
    {
        <section class="editor-section" aria-labelledby="@uid-basics">
            <h2 class="@(simple ? "h5 editor-heading" : "visually-hidden")" id="@uid-basics">Basics</h2>
            <div class="mb-3">
                <label class="form-label" for="@Id("title")">Title</label>
                <input id="@Id("title")" class="form-control @Invalid("title")" maxlength="@(Limits.TitleMax + 50)"
                       aria-describedby="@DescribedBy("title")" aria-invalid="@AriaInvalid("title")"
                       @bind="draft.Title" @bind:event="oninput" @bind:after="@(() => Changed("title"))" />
                @FieldErrors("title")
            </div>
            <div class="mb-1">
                <div class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-1">
                    <label class="form-label mb-0" for="@Id("description")">Description</label>
                    @Segmented("descmode", [("Write", !descriptionPreview, () => { descriptionPreview = false; return Task.CompletedTask; }),
                                            ("Preview", descriptionPreview, () => { descriptionPreview = true; return Task.CompletedTask; })], "Description view", small: true)
                </div>
                @if (descriptionPreview)
                {
                    <div class="editor-md-preview poll-markdown">
                        @if (string.IsNullOrWhiteSpace(draft.Description))
                        {
                            <span class="text-secondary">Nothing to preview.</span>
                        }
                        else if (draft.Description.Trim().Length > Limits.DescriptionMax)
                        {
                            <span class="text-secondary">Too long to preview.</span>
                        }
                        else
                        {
                            @MarkdownRenderer.Render(draft.Description)
                        }
                    </div>
                }
                else
                {
                    <textarea id="@Id("description")" class="form-control editor-textarea @Invalid("description")" rows="@(simple ? 5 : 3)"
                              aria-describedby="@DescribedBy("description", Id("description") + "-count")" aria-invalid="@AriaInvalid("description")"
                              @bind="draft.Description" @bind:event="oninput" @bind:after="@(() => Changed("description"))"></textarea>
                }
                <div class="d-flex justify-content-between gap-2 form-text">
                    <span>Markdown</span>
                    <span id="@(Id("description"))-count" class="editor-count @((draft.Description ?? "").Trim().Length > Limits.DescriptionMax ? "editor-count-over" : "")">
                        @((draft.Description ?? "").Trim().Length) / @Limits.DescriptionMax
                    </span>
                </div>
                @FieldErrors("description")
            </div>
        </section>
    };

    /// <summary>
    /// Add question · Add group · Add page (DESIGN.md §34.5): under the options in the simple editor (any of them turns it into
    /// the structured editor) and under the outline. Disabled at the admin's limits.
    /// </summary>
    private RenderFragment AddBar(QuestionDraft? at) => __builder =>
    {
        <div class="editor-addbar">
            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(draft.Questions.Count >= Limits.QuestionsMax)"
                    @onclick="() => AddAsync(AddKind.Question)"><Icon Name="plus" /> Add question</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(draft.Groups.Count >= Limits.GroupsMax || draft.Questions.Count >= Limits.QuestionsMax)"
                    @onclick="() => AddAsync(AddKind.Group)"><Icon Name="plus" /> Add group</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(draft.Pages.Count + (draft.Pages.Count == 0 ? 2 : 1) > Limits.PagesMax || draft.Questions.Count >= Limits.QuestionsMax)"
                    @onclick="() => AddAsync(AddKind.Page)"><Icon Name="plus" /> Add page</button>
            <OptionHelp Label="Questions, groups and pages">
                <p>A poll holds up to @Limits.QuestionsMax questions, @Limits.PagesMax pages and @Limits.GroupsMax groups. With more
                    than one question each needs its text; the poll title is no longer the question.</p>
                <p><strong>Group</strong>: a titled box of questions on one page, such as one per person. <strong>Page</strong>:
                    voters answer page by page, with Back and Next; the ballot is saved on the last page. Every page needs a
                    question, and the first page added takes the questions so far.</p>
                <p>After voting started, questions can be added and removed: a removed question's answers stay in the ballots and
                    no longer count. Its type and rules stay fixed.</p>
            </OptionHelp>
        </div>
    };

    private RenderFragment Tab(EditorTab which, string label) => __builder =>
    {
        var on = tab == which;
        <button type="button" role="tab" class="editor-tab @(on ? "active" : "")" id="@uid-tab-@which" aria-selected="@(on ? "true" : "false")"
                aria-controls="@uid-panel" tabindex="@(on ? 0 : -1)" @onclick="() => tab = which">@label
            @if (which == EditorTab.Voting && TabErrors(which))
            {
                <span class="outline-err" aria-hidden="true"></span><span class="visually-hidden">, has errors</span>
            }
        </button>
    };

    private RenderFragment VotingAndResults() => __builder =>
    {
        @if (Existing is null)
        {
        @* ---- Voting ---- *@
        <section class="editor-section" aria-labelledby="@uid-voting">
            <h2 class="h5 editor-heading" id="@uid-voting">Voting</h2>
            @Radios("voters", "Who votes", VotersHelp(), [
                ("Anyone with the link", draft.VoterMode == VoterMode.Public, () => SetAsync(() => draft.VoterMode = VoterMode.Public, "voters")),
                ("Signed-in accounts", draft.VoterMode == VoterMode.Accounts, () => SetAsync(() => draft.VoterMode = VoterMode.Accounts, "voters")),
                ("Invite links", draft.VoterMode == VoterMode.Invite, () => SetAsync(() => draft.VoterMode = VoterMode.Invite, "voters"))])
            @Radios("responses", "Responses", ResponsesHelp(), [
                ("One", draft.Responses == ResponsePolicy.One, () => SetAsync(() => draft.Responses = ResponsePolicy.One, "responses")),
                ("Several", draft.Responses == ResponsePolicy.Many, () => SetAsync(() => draft.Responses = ResponsePolicy.Many, "responses"))])
            @Radios("names", "Names", NamesHelp(), [
                ("None", draft.Names == NamesMode.None, () => SetAsync(() => draft.Names = NamesMode.None, "names")),
                ("Optional", draft.Names == NamesMode.Optional, () => SetAsync(() => draft.Names = NamesMode.Optional, "names")),
                ("Required", draft.Names == NamesMode.Required, () => SetAsync(() => draft.Names = NamesMode.Required, "names"))])
        </section>

        @* ---- Results (DESIGN.md §25) ---- *@
        <section class="editor-section" aria-labelledby="@uid-results">
            <h2 class="h5 editor-heading" id="@uid-results">Results</h2>
            @Radios("results", "Results for", ResultsForHelp(), [
                ("Owner only", draft.ResultsVisibility == ResultsVisibility.Creator, () => SetAsync(() => draft.ResultsVisibility = ResultsVisibility.Creator, "results")),
                ("Voters", draft.ResultsVisibility == ResultsVisibility.AfterVote, () => SetAsync(() => draft.ResultsVisibility = ResultsVisibility.AfterVote, "results")),
                ("Anyone with the link", draft.ResultsVisibility == ResultsVisibility.Open, () => SetAsync(() => draft.ResultsVisibility = ResultsVisibility.Open, "results"))],
                disabled: i => i == 2 && draft.VoterMode != VoterMode.Public)
            @Radios("resultsTiming", "Show results", ResultsTimingHelp(), [
                ("While voting", draft.ResultsTiming == ResultsTiming.WhileOpen, () => SetAsync(() => draft.ResultsTiming = ResultsTiming.WhileOpen, "resultsTiming")),
                ("After closing", draft.ResultsTiming == ResultsTiming.AfterClose, () => SetAsync(() => draft.ResultsTiming = ResultsTiming.AfterClose, "resultsTiming"))],
                disabled: _ => draft.ResultsVisibility == ResultsVisibility.Creator)
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="@Id("showBallots")" disabled="@(draft.Names == NamesMode.None)"
                       aria-describedby="@DescribedBy("showBallots")" @bind="draft.ShowBallots" @bind:after="@(() => SetAsync(() => { }, "showBallots"))" />
                <label class="form-check-label" for="@Id("showBallots")">Show ballots to voters</label>
                @ShowBallotsHelp()
                @FieldErrors("showBallots")
            </div>
        </section>
        }
        else
        {
            @FixedSettings()
        }

        @* ---- Closing ---- *@
        <section class="editor-section" aria-labelledby="@uid-closing">
            <h2 class="h5 editor-heading" id="@uid-closing">Closing</h2>
            <div class="row g-3">
                <div class="col-sm-6 option-field">
                    <label class="form-label" for="@Id("closesOn")">Closes on</label>
                    <OptionHelp Label="Closes on">
                        <p>The poll closes at the end of this day in the poll's time zone: voting stops, the results stay. Empty:
                            it closes automatically after the site's maximum poll duration, or stays open when there is none (the
                            line under the field says which).</p>
                        <p>The share page closes the poll early or reopens it; a later date here reopens a poll closed by its date.</p>
                    </OptionHelp>
                    <input id="@Id("closesOn")" type="date" class="form-control @Invalid("closesOn")"
                           max="@LatestClose?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)"
                           aria-describedby="@DescribedBy("closesOn", Id("closesOn") + "-hint")" aria-invalid="@AriaInvalid("closesOn")"
                           @bind="draft.ClosesOn" @bind:after="@(() => Changed("closesOn"))" />
                    <div class="form-text" id="@(Id("closesOn"))-hint">@AutoCloseText</div>
                    @FieldErrors("closesOn")
                </div>
                @if (Existing is null)
                {
                <div class="col-sm-6 option-field">
                    <label class="form-label" for="@Id("timezone")">Time zone</label>
                    @TimeZoneHelp()
                    <input id="@Id("timezone")" class="form-control @Invalid("timezone")" list="@uid-zones" autocomplete="off" spellcheck="false"
                           placeholder="@(DefaultTimeZone ?? PollTime.Utc)"
                           aria-describedby="@DescribedBy("timezone")" aria-invalid="@AriaInvalid("timezone")"
                           @bind="draft.TimeZone" @bind:after="@(() => Changed("timezone"))" />
                    <datalist id="@uid-zones">
                        @foreach (var z in TimeZones.All)
                        {
                            <option value="@z"></option>
                        }
                    </datalist>
                    @FieldErrors("timezone")
                </div>
                }
            </div>
        </section>
    };

    // ---- the structured editor: outline and selected item (DESIGN.md §34.5) ----

    private RenderFragment Outline() => __builder =>
    {
        <nav class="editor-outline" aria-label="Outline">
            @if (draft.Pages.Count == 0)
            {
                <ol class="outline-list">
                    @Blocks(draft.Questions)
                </ol>
            }
            else
            {
                <ol class="outline-list">
                    @for (var p = 0; p < draft.Pages.Count; p++)
                    {
                        var page = draft.Pages[p];
                        var pi = p;
                        <li class="outline-page" @key="KeyOf(page)">
                            @OutlineButton(page, $"{pi + 1} · {(string.IsNullOrWhiteSpace(page.Title) ? "Page" : page.Title.Trim())}", null,
                                PageHasErrors(pi), "outline-page-btn")
                            <ol class="outline-list outline-nested">
                                @Blocks(draft.Questions.Where(q => DraftOutline.PageIndex(draft, q) == pi).ToList())
                            </ol>
                        </li>
                    }
                </ol>
            }
            @AddBar(selected as QuestionDraft)
        </nav>
    };

    /// <summary>The questions of one page in runs of the same group: a group's box holds its questions.</summary>
    private RenderFragment Blocks(IReadOnlyList<QuestionDraft> questions) => __builder =>
    {
        var i = 0;
        while (i < questions.Count)
        {
            var q = questions[i];
            if (DraftOutline.GroupOf(draft, q) is { } g)
            {
                var run = new List<QuestionDraft>();
                while (i < questions.Count && questions[i].Group == q.Group) run.Add(questions[i++]);
                var gi = draft.Groups.IndexOf(g);
                <li class="outline-group" @key="KeyOf(g)">
                    @OutlineButton(g, "Group · " + (string.IsNullOrWhiteSpace(g.Title) ? "Untitled" : g.Title.Trim()), null, GroupHasErrors(gi), "outline-group-btn")
                    <ol class="outline-list outline-nested">
                        @foreach (var gq in run)
                        {
                            @QuestionRow(gq)
                        }
                    </ol>
                </li>
            }
            else
            {
                @QuestionRow(q)
                i++;
            }
        }
    };

    private RenderFragment QuestionRow(QuestionDraft q) => __builder =>
    {
        var index = DraftOutline.IndexOf(draft, q);
        var label = q.Prompt.Trim().Length > 0 ? q.Prompt.Trim() : $"Question {index + 1}";
        <li @key="KeyOf(q)">
            @OutlineButton(q, label, DraftOutline.TypeLabel(q.Type, q.MaxSelect), QuestionHasErrors(index), "outline-question")
        </li>
    };

    private RenderFragment OutlineButton(object item, string label, string? type, bool errors, string css) => __builder =>
    {
        var on = ReferenceEquals(item, selected);
        <button type="button" class="outline-item @css @(on ? "selected" : "")" aria-current="@(on ? "true" : null)" @onclick="() => Select(item)">
            <span class="outline-label text-break">@label</span>
            @if (type is not null)
            {
                <span class="outline-type">@type</span>
            }
            @if (errors)
            {
                <span class="outline-err" aria-hidden="true"></span><span class="visually-hidden">, has errors</span>
            }
        </button>
    };

    private RenderFragment SelectedItem() => __builder =>
    {
        switch (selected)
        {
            case QuestionDraft q:
            {
                var index = DraftOutline.IndexOf(draft, q);
                var page = DraftOutline.PageOf(draft, q);
                var group = DraftOutline.GroupOf(draft, q);
                var place = new List<string>();
                if (page is not null) place.Add($"Page {draft.Pages.IndexOf(page) + 1}");
                if (group is not null) place.Add("Group: " + (string.IsNullOrWhiteSpace(group.Title) ? "untitled" : group.Title.Trim()));
                place.Add($"Question {index + 1} of {draft.Questions.Count}");
                <div class="editor-item-head">
                    <span class="small text-secondary editor-item-place">@string.Join(" · ", place)</span>
                    <div class="editor-option-actions">
                        <button type="button" class="btn btn-sm btn-outline-secondary btn-icon" aria-label="Move question up" title="Move up"
                                disabled="@(!DraftOutline.CanMoveUp(draft, q))" @onclick="() => OutlineAsync(() => DraftOutline.MoveUp(draft, q))"><Icon Name="arrow-up" /></button>
                        <button type="button" class="btn btn-sm btn-outline-secondary btn-icon" aria-label="Move question down" title="Move down"
                                disabled="@(!DraftOutline.CanMoveDown(draft, q))" @onclick="() => OutlineAsync(() => DraftOutline.MoveDown(draft, q))"><Icon Name="arrow-down" /></button>
                        <button type="button" class="btn btn-sm btn-outline-secondary btn-icon" aria-label="Remove question" title="Remove"
                                disabled="@(draft.Questions.Count <= 1)" @onclick="() => RemoveQuestionAsync(q)"><Icon Name="x" /></button>
                    </div>
                </div>
                <QuestionEditor @key="KeyOf(q)" Editor="ctx" Question="q" Index="index" />
                break;
            }
            case PageDraft p:
            {
                var pi = draft.Pages.IndexOf(p);
                var f = $"pages[{pi}]";
                <div class="editor-item-head">
                    <span class="small text-secondary editor-item-place">Page @(pi + 1) of @draft.Pages.Count</span>
                    <div class="editor-option-actions">
                        <button type="button" class="btn btn-sm btn-outline-secondary btn-icon" aria-label="Move page up" title="Move up"
                                disabled="@(pi == 0)" @onclick="() => OutlineAsync(() => DraftOutline.MovePage(draft, p, -1))"><Icon Name="arrow-up" /></button>
                        <button type="button" class="btn btn-sm btn-outline-secondary btn-icon" aria-label="Move page down" title="Move down"
                                disabled="@(pi == draft.Pages.Count - 1)" @onclick="() => OutlineAsync(() => DraftOutline.MovePage(draft, p, 1))"><Icon Name="arrow-down" /></button>
                        <button type="button" class="btn btn-sm btn-outline-secondary btn-icon" aria-label="Remove page" title="Remove"
                                @onclick="() => RemovePageAsync(p)"><Icon Name="x" /></button>
                    </div>
                </div>
                @FieldErrors(f)
                <div class="mb-3">
                    <label class="form-label" for="@Id($"{f}.title")">Page title</label>
                    <OptionHelp Label="Page title">
                        <p>Shown above the page and in the page list voters see ("2 · Food"), at most @Limits.TitleMax characters.
                            It can change at any time and is not recorded in the change log.</p>
                    </OptionHelp>
                    <input id="@Id($"{f}.title")" class="form-control @Invalid($"{f}.title")" maxlength="@(Limits.TitleMax + 50)"
                           aria-describedby="@DescribedBy($"{f}.title")" aria-invalid="@AriaInvalid($"{f}.title")"
                           @bind="p.Title" @bind:event="oninput" @bind:after="@(() => Changed($"{f}.title"))" />
                    @FieldErrors($"{f}.title")
                </div>
                <div class="mb-3">
                    <label class="form-label" for="@Id($"{f}.description")">Page description</label>
                    <OptionHelp Label="Page description">
                        <p>Shown under the page title, in Markdown, at most @Limits.DescriptionMax characters. Optional.</p>
                        <p>Removing a page moves its questions to the page before it (the first page's to the next one); removing
                            the last page leaves one page without a title.</p>
                    </OptionHelp>
                    <textarea id="@Id($"{f}.description")" class="form-control editor-textarea @Invalid($"{f}.description")" rows="3"
                              aria-describedby="@DescribedBy($"{f}.description")" aria-invalid="@AriaInvalid($"{f}.description")"
                              @bind="p.Description" @bind:event="oninput" @bind:after="@(() => Changed($"{f}.description"))"></textarea>
                    @FieldErrors($"{f}.description")
                </div>
                <button type="button" class="btn btn-sm btn-outline-primary" disabled="@(draft.Questions.Count >= Limits.QuestionsMax)"
                        @onclick="() => AddOnPageAsync(p)"><Icon Name="plus" /> Add question</button>
                break;
            }
            case GroupDraft g:
            {
                var gi = draft.Groups.IndexOf(g);
                var f = $"groups[{gi}]";
                var first = DraftOutline.QuestionsOf(draft, g).FirstOrDefault();
                var page = first is null ? null : DraftOutline.PageOf(draft, first);
                <div class="editor-item-head">
                    <span class="small text-secondary editor-item-place">@(page is null ? "Group" : $"Group · page {draft.Pages.IndexOf(page) + 1}")</span>
                    <div class="editor-option-actions">
                        <button type="button" class="btn btn-sm btn-outline-secondary btn-icon" aria-label="Remove group" title="Remove"
                                @onclick="() => RemoveGroupAsync(g)"><Icon Name="x" /></button>
                    </div>
                </div>
                @FieldErrors(f)
                <div class="mb-3">
                    <label class="form-label" for="@Id($"{f}.title")">Group title</label>
                    <OptionHelp Label="Group title">
                        <p>The heading of the box around the group's questions, at most @Limits.TitleMax characters. A group's
                            questions stay together on one page: Move up and Move down take a question into or out of the group
                            next to it.</p>
                    </OptionHelp>
                    <input id="@Id($"{f}.title")" class="form-control @Invalid($"{f}.title")" maxlength="@(Limits.TitleMax + 50)"
                           aria-describedby="@DescribedBy($"{f}.title")" aria-invalid="@AriaInvalid($"{f}.title")"
                           @bind="g.Title" @bind:event="oninput" @bind:after="@(() => Changed($"{f}.title"))" />
                    @FieldErrors($"{f}.title")
                </div>
                <div class="mb-3">
                    <label class="form-label" for="@Id($"{f}.description")">Group description</label>
                    <OptionHelp Label="Group description">
                        <p>Shown under the group title, in Markdown, at most @Limits.DescriptionMax characters. Optional. Removing
                            the group keeps its questions, outside any group.</p>
                    </OptionHelp>
                    <textarea id="@Id($"{f}.description")" class="form-control editor-textarea @Invalid($"{f}.description")" rows="3"
                              aria-describedby="@DescribedBy($"{f}.description")" aria-invalid="@AriaInvalid($"{f}.description")"
                              @bind="g.Description" @bind:event="oninput" @bind:after="@(() => Changed($"{f}.description"))"></textarea>
                    @FieldErrors($"{f}.description")
                </div>
                break;
            }
            default:
                break;
        }
    };

    // ---- option help (DESIGN.md §23.4), written from the validator and PollAccessService ----

    private RenderFragment TimeZoneHelp() => __builder =>
    {
        <OptionHelp Label="Time zone">
            <p>The zone of the close date and of the times of date options, which are shown as typed with the zone
                named. The closing time is shown to each viewer in their account's time zone, else in this one.</p>
            <p>A new poll starts with your account's time zone, else this browser's.</p>
        </OptionHelp>
    };

    private RenderFragment ShowBallotsHelp() => __builder =>
    {
        <OptionHelp Label="Show ballots to voters">
            <p>Whoever sees the results also sees every response: the name as entered (blank: Anonymous) and the answers.
                Never who sent it, when, or your aliases. Only when the poll asks for names.</p>
            <p>Ballots appear in voting order, so someone watching the results while people vote can tell which one is new.</p>
        </OptionHelp>
    };

    /// <summary>
    /// On edit (DESIGN.md §26): the poll's settings fixed at creation as read-only text, each with its help (the questions'
    /// own fixed rules are in their QuestionEditor). A different setup is a copy of the poll.
    /// </summary>
    private RenderFragment FixedSettings() => __builder =>
    {
        var e = Existing!;
        <section class="editor-section" aria-labelledby="@uid-fixed">
            <h2 class="h5 editor-heading" id="@uid-fixed">Settings</h2>
            <p class="small text-secondary mb-2 editor-fixed-note"><Icon Name="lock" /> Fixed when the poll was created.</p>
            <div class="editor-fixed">
                @Fixed("Who votes", e.Voters switch { VoterMode.Accounts => "Signed-in accounts", VoterMode.Invite => "Invite links", _ => "Anyone with the link" },
                    Wrapped("Who votes", VotersHelp()))
                @Fixed("Responses", e.Responses == ResponsePolicy.Many ? "Several" : "One", Wrapped("Responses", ResponsesHelp()))
                @Fixed("Names", e.Names switch { NamesMode.None => "None", NamesMode.Required => "Required", _ => "Optional" }, Wrapped("Names", NamesHelp()))
                @Fixed("Results for", e.Results switch { ResultsVisibility.Creator => "Owner only", ResultsVisibility.Open => "Anyone with the link", _ => "Voters" },
                    Wrapped("Results for", ResultsForHelp()))
                @Fixed("Show results", e.ResultsTiming == ResultsTiming.AfterClose ? "After closing" : "While voting", Wrapped("Show results", ResultsTimingHelp()))
                @Fixed("Show ballots to voters", YesNo(e.ShowBallots), ShowBallotsHelp())
                @Fixed("Time zone", e.TimeZone ?? PollTime.Utc, TimeZoneHelp())
            </div>
        </section>
    };

    private static string YesNo(bool b) => b ? "Yes" : "No";

    private RenderFragment Wrapped(string label, RenderFragment help) => __builder =>
    {
        <OptionHelp Label="@label">@help</OptionHelp>
    };

    private RenderFragment Fixed(string label, string value, RenderFragment help) => __builder =>
    {
        <div class="editor-fixed-row option-field">
            <span class="editor-fixed-label">@label</span>
            @help
            <span class="editor-fixed-value">@value</span>
        </div>
    };

    private RenderFragment VotersHelp() => __builder =>
    {
        <ul>
            <li><strong>Anyone with the link</strong>: no account needed. A visitor who is not signed in votes as their browser
                (a cookie), a signed-in visitor as their account. The site may ask visitors who are not signed in for a
                captcha.</li>
            <li><strong>Signed-in accounts</strong>: voters need an account on this site with a verified email. Others can open
                the poll but not vote.</li>
            <li><strong>Invite links</strong>: each voter needs a personal link, made on the share page once the poll exists. No
                account needed; once a signed-in voter uses a link, it belongs to that account.</li>
        </ul>
    };

    private RenderFragment ResponsesHelp() => __builder =>
    {
        <p><strong>One</strong>: one response per voter, which they can change until the poll closes. <strong>Several</strong>:
            a voter can send more than one and change or delete each; the site may cap how many.</p>
        <p>One voter is:</p>
        <ul>
            <li>with Anyone with the link, a browser, or an account when signed in. An honour system: another browser counts as
                another voter.</li>
            <li>with Signed-in accounts, an account.</li>
            <li>with Invite links, a link: with Several, one link can answer for a household or a team.</li>
        </ul>
    };

    private RenderFragment NamesHelp() => __builder =>
    {
        <p><strong>None</strong>: the vote form asks for no name. <strong>Optional</strong>: it asks for a name that may stay
            empty. <strong>Required</strong>: a name must be given.</p>
        <p>You see the names: in the responses on the share page, in the ballots CSV and, for dates polls, in the results
            grid of who can when. Voters see them only with Show ballots to voters.</p>
    };

    private RenderFragment ResultsForHelp() => __builder =>
    {
        <ul>
            <li><strong>Owner only</strong>: only you.</li>
            <li><strong>Voters</strong>: a voter, once they have sent a response, from the browser, account or link they voted
                with.</li>
            <li><strong>Anyone with the link</strong>: everyone who can open the poll page, voted or not. Only for polls anyone
                with the link can vote in: the address of an invite or account poll never shows its results.</li>
        </ul>
        <p>You always see the results, live. Text answers and Other texts are yours only, whatever is chosen here.</p>
    };

    private RenderFragment ResultsTimingHelp() => __builder =>
    {
        <p><strong>While voting</strong>: the results show the responses so far while the poll is open; to voters once they
            have voted, with Anyone with the link right away. <strong>After closing</strong>: nobody but you sees them until
            the poll closes, by its date or when you close it.</p>
        <p>With Owner only this stays While voting.</p>
    };

    private Task SetAsync(Action set, string field)
    {
        set();
        Normalise(draft);
        return ChangedAsync(field);
    }

    private RenderFragment FieldErrors(string field) => __builder =>
    {
        var messages = ErrorsOf(field);
        if (messages.Count > 0)
        {
            <div class="invalid-feedback d-block" id="@ctx.ErrId(field)">
                @foreach (var m in messages)
                {
                    <div>@m</div>
                }
            </div>
        }
    };

    /// <summary>Segmented buttons: radio inputs (keyboard: arrows) styled as one control.</summary>
    private RenderFragment Segmented(string group, IReadOnlyList<(string Label, bool Checked, Func<Task> Select)> items, string label, bool small = false) => __builder =>
    {
        <div class="seg @(small ? "seg-sm" : "")" role="radiogroup" aria-label="@label">
            @for (var i = 0; i < items.Count; i++)
            {
                var item = items[i];
                var id = $"{Name(group)}-{i}";
                <input type="radio" class="btn-check" name="@Name(group)" id="@id" checked="@item.Checked" @onchange="item.Select" />
                <label class="seg-btn" for="@id">@item.Label</label>
            }
        </div>
    };

    /// <summary>A radio group with its option help: the legend for assistive technology, the same text shown beside the
    /// help toggle, the panel under the radios.</summary>
    private RenderFragment Radios(string field, string legend, RenderFragment help, IReadOnlyList<(string Label, bool Checked, Func<Task> Select)> items,
        Func<int, bool>? disabled = null) => __builder =>
    {
        <fieldset class="mb-3" aria-describedby="@DescribedBy(field)">
            <legend class="visually-hidden">@legend</legend>
            <div class="option-field">
            <span class="form-label fs-6 mb-1" aria-hidden="true">@legend</span>
            <OptionHelp Label="@legend">@help</OptionHelp>
            <div class="editor-radios">
                @for (var i = 0; i < items.Count; i++)
                {
                    var item = items[i];
                    var id = $"{Name(field)}-{i}";
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="@Name(field)" id="@id" checked="@item.Checked" disabled="@(disabled?.Invoke(i) == true)"
                               @onchange="item.Select" />
                        <label class="form-check-label" for="@id">@item.Label</label>
                    </div>
                }
            </div>
            @FieldErrors(field)
            </div>
        </fieldset>
    };
}
