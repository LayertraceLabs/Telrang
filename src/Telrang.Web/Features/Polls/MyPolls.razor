@page "/polls"
@layout MainLayout
@attribute [Authorize]
@inject IOptions<AppOptions> AppOptions
@inject PollService Polls
@inject UserManager<ApplicationUser> Users

<PageTitle>My polls - @AppOptions.Value.Name</PageTitle>

<PageHeader Title="My polls">
    <Actions><a class="btn btn-primary" href="polls/new">New poll</a></Actions>
</PageHeader>

@if (statusMessage is not null)
{
    <div class="alert alert-info" role="status">@statusMessage</div>
}

@if (polls is null)
{
    <p class="text-secondary">Loading…</p>
}
else if (polls.Count == 0)
{
    <EmptyState Text="No polls yet."><a class="btn btn-primary" href="polls/new">New poll</a></EmptyState>
}
else
{
    <div class="list-group poll-list">
        @foreach (var p in polls)
        {
            <div class="list-group-item py-3" @key="p.EncodedId">
                <div class="d-flex flex-wrap justify-content-between gap-2">
                    @* Owners land on the results (DESIGN.md §24.3); "Vote" opens the ballot. *@
                    <a class="fw-semibold fs-5 text-break" href="p/@p.EncodedId/results" data-enhance-nav="false">@p.Title</a>
                    <span class="badge @(p.IsClosed ? "text-bg-secondary" : "badge-open") align-self-start">@(p.IsClosed ? "Closed" : "Open")</span>
                </div>
                <div class="small text-secondary mb-2">
                    @PollText.TypeName(p.Type) · @p.BallotCount @(p.BallotCount == 1 ? "vote" : "votes") · created @PollText.Date(p.CreatedAt)
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-sm btn-outline-primary" href="polls/@p.EncodedId/edit">Edit</a>
                    <a class="btn btn-sm btn-outline-primary" href="polls/@p.EncodedId/share">Share</a>
                    <a class="btn btn-sm btn-outline-primary" href="p/@p.EncodedId" data-enhance-nav="false">Vote</a>
                    <a class="btn btn-sm btn-outline-primary" href="polls/new?from=@p.EncodedId">Copy</a>
                    @if (confirmDelete != p.EncodedId)
                    {
                        <button type="button" class="btn btn-sm btn-outline-danger ms-auto" @onclick="() => AskDelete(p.EncodedId)">Delete…</button>
                    }
                </div>
                @if (confirmDelete == p.EncodedId)
                {
                    <div class="confirm-panel mt-2">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="confirm-@p.EncodedId" @bind="confirmChecked" />
                            <label class="form-check-label" for="confirm-@p.EncodedId">
                                Delete “@p.Title” and its @p.BallotCount @(p.BallotCount == 1 ? "ballot" : "ballots") and invite links permanently.
                            </label>
                        </div>
                        <div class="d-flex flex-wrap gap-2 mt-2">
                            <button type="button" class="btn btn-sm btn-danger" disabled="@(!confirmChecked || busy)" @onclick="() => DeleteAsync(p.EncodedId)">Delete poll</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => AskDelete(null)">Cancel</button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;
    private IReadOnlyList<PollSummary>? polls;
    private string? confirmDelete, statusMessage;
    private bool confirmChecked, busy;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task<string?> UserIdAsync() => Users.GetUserId((await AuthState).User);

    private async Task LoadAsync()
    {
        var userId = await UserIdAsync();
        polls = userId is null ? [] : await Polls.ListOwnedAsync(userId);
    }

    private void AskDelete(string? encodedId)
    {
        confirmDelete = encodedId;
        confirmChecked = false;
    }

    private async Task DeleteAsync(string encodedId)
    {
        if (!confirmChecked) return;
        busy = true;
        try
        {
            var title = polls?.FirstOrDefault(p => p.EncodedId == encodedId)?.Title;
            var ok = await UserIdAsync() is { } userId && await Polls.DeletePollAsync(userId, encodedId);
            statusMessage = ok ? $"Deleted “{title}”." : "That poll could not be deleted.";
            confirmDelete = null;
            await LoadAsync();
        }
        finally { busy = false; }
    }
}
